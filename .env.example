# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the blanks.
#   cp .env.example .env.local
# .env.local is gitignored. .env.example is committed and must never hold a
# real value.
# Every service below has a free tier. Three of the four are required.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. Gemini — REQUIRED ─────────────────────────────────────────────────────
# Powers all three AI layers: the in-call voice agent (Live API), summaries and
# action-item extraction, and the embeddings behind search / Ask.
# Get one at: https://aistudio.google.com/apikey  (free tier, no card)
# Server-only. The browser never sees this — the voice agent connects with a
# short-lived ephemeral token minted from it instead.
GEMINI_API_KEY=

# Model ids. Defaults are fine; override only to test a different model.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001


# ── 2. Neon Postgres — REQUIRED ──────────────────────────────────────────────
# Meetings, transcripts, summaries, action items, highlights, share links — and
# the pgvector index that search and Ask retrieve from. One database, so RAG
# needs no separate vector-store account.
# Sign up at: https://neon.tech  → create a project → Connection Details
# Free tier is plenty for this.
#
# Copy the POOLED string here (the host contains "-pooler"). Used at runtime.
DATABASE_URL=

# Copy the DIRECT / unpooled string here (same host, without "-pooler").
# Migrations need a non-pooled connection.
DATABASE_URL_UNPOOLED=

# After the project exists, enable the extension once:
#   CREATE EXTENSION IF NOT EXISTS vector;


# ── 3b. Groq — REQUIRED for the Ask scope/safety guardrail ───────────────────
# A second, independent model checks every Ask message against a fixed policy
# (meetings-only scope, jailbreak/injection, unsafe content) BEFORE it ever
# reaches Gemini — a different vendor, so a prompt trick that works on one
# doesn't automatically work on the other. If unset, Ask still runs but this
# extra layer is skipped (logged), not silently unsafe: Gemini's own
# generation still declines out-of-scope requests via its system prompt.
# Get one at: https://console.groq.com/keys  (generous free tier, no card)
GROQ_API_KEY=


# ── 3c. Vercel Blob — REQUIRED for recording playback ─────────────────────────
# Stores the audio/video captured in the test meeting room, so playback after a
# call is a real recording rather than a placeholder.
# Vercel dashboard → Storage → Create Blob store → copy the read/write token.
# Locally you can also run `vercel env pull .env.local` to fetch it.
# Without this the app still runs; recordings just are not persisted.
BLOB_READ_WRITE_TOKEN=


# ── 4. App config ────────────────────────────────────────────────────────────
# Public base URL. Used to build share links, so it must match where the app is
# actually served or shared clips will point at the wrong host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs the anonymous workspace cookie. There is no login: each visitor gets a
# workspace keyed by a signed cookie, and this stops anyone forging someone
# else's workspace id and reading their meetings.
# Generate with:  openssl rand -base64 32
SESSION_SECRET=

# Workspace id holding the seeded demo meetings. Anyone who opens the live link
# signed out lands here, read-only. Set by the seed script — leave blank until
# you have run it.
DEMO_WORKSPACE_ID=
